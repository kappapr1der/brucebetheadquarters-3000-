TELEGRAM_BOT_TOKEN=put_botfather_token_here

# Comma-separated Telegram chat IDs. Required in production; startup fails closed when empty.
# Use @userinfobot to learn your chat id before starting BruceBet.
TELEGRAM_ALLOWED_CHAT_IDS=
# Development only. Never set this in production compose or .env.
BRUCEBET_ALLOW_UNRESTRICTED_CHATS=0

BRUCEBET_DB_PATH=data/forecasters.sqlite
BRUCEBET_DATA_DIR=data
BRUCEBET_USER_PARTICIPANT="Bruce Wayne"
BRUCEBET_COMPETITION=epl
BRUCEBET_SEASON=2026/27
BRUCEBET_SEASON_DISPLAY="EPL 2026/27"
BRUCEBET_LOCK_MINUTES=90
BRUCEBET_TIMEZONE=Europe/Moscow

PREMIER_LEAGUE_COMPSEASON_ID=841
PREMIER_LEAGUE_SEASON_LABEL=2026/2027

BRUCEBET_AUTO_SYNC=1
BRUCEBET_AUTO_SYNC_INTERVAL_HOURS=12
BRUCEBET_AUTO_SYNC_FIRST_DELAY_MINUTES=5
BRUCEBET_REMINDER_INTERVAL_MINUTES=5
BRUCEBET_REMINDER_GRACE_MINUTES=35
# Bruce's contest-pick ledger is frozen this many minutes before the effective
# round deadline. The dispatcher checks every minute and never writes /predictions.
BRUCEBET_FINAL_PICK_LEAD_MINUTES=10
BRUCEBET_VARIABLE_DAYS_AHEAD=365
BRUCEBET_WEATHER_DAYS_AHEAD=16
BRUCEBET_SNAPSHOT_LABEL=server-auto
BRUCEBET_SNAPSHOT_OUT_DIR=data/snapshots/current
BRUCEBET_SNAPSHOT_REPO=/opt/brucebet-3000/data/snapshots
BRUCEBET_SNAPSHOT_PUSH=auto

# Forecasters Club public discussion reader. No VK token is required.
VK_GROUP_ID=217130885
VK_REGISTRATION_TOPIC_ID=
VK_PREDICTIONS_TOPIC_ID=
# Public Chromium reading is the primary route. VK's API may reject discussion
# reads even after sign-in, so OAuth is off unless it is explicitly re-enabled.
VK_API_READ_ENABLED=0
VK_API_VERSION=5.199
VK_API_TIMEOUT_SECONDS=20
VK_OAUTH_ENABLED=0

# `vk_id` works for sign-in only. Use `legacy` with a Standalone application
# when read access to VK discussion API methods is required.
VK_OAUTH_PROVIDER=vk_id
VK_OAUTH_CLIENT_ID=54715552
VK_OAUTH_CLIENT_SECRET=
VK_OAUTH_LEGACY_SCOPE=groups
# Free Worker relay: https://<worker>.<account>.workers.dev
# Its exact callback is https://<worker>.<account>.workers.dev/vk/oauth/callback.
VK_OAUTH_WORKER_URL=
VK_OAUTH_WORKER_RELAY_SECRET=
VK_OAUTH_WORKER_POLL_INTERVAL_SECONDS=15
VK_OAUTH_WORKER_TIMEOUT_SECONDS=20
VK_OAUTH_REDIRECT_URI=https://<worker>.<account>.workers.dev/vk/oauth/callback
VK_OAUTH_CREDENTIALS_PATH=data/vk_oauth_credentials.json
VK_OAUTH_STATE_PATH=data/vk_oauth_state.json
VK_OAUTH_STATE_TTL_MINUTES=15
VK_OAUTH_BIND_HOST=0.0.0.0
VK_OAUTH_PORT=8090

VK_REGISTRATION_SYNC_ENABLED=0
VK_REGISTRATION_SYNC_INTERVAL_MINUTES=5
VK_REGISTRATION_SYNC_FIRST_DELAY_SECONDS=20
VK_REGISTRATION_BROWSER_WAIT_MS=12000
VK_PREDICTIONS_SNAPSHOT_ENABLED=0
# Explicit local-write gate. VK itself remains read-only; accepted EPL forecasts
# are projected into Brucebet SQLite only when this is enabled.
VK_PREDICTIONS_IMPORT_ENABLED=0
VK_PREDICTIONS_SNAPSHOT_INTERVAL_MINUTES=20
# Local server archive only. Never point this at a public Git remote.
VK_PUBLIC_SNAPSHOT_DIR=data/vk_snapshots
VK_CHALLENGE_ALERT_COOLDOWN_MINUTES=360
VK_TOPIC_DISCOVERY_ENABLED=1
VK_TOPIC_DISCOVERY_INTERVAL_MINUTES=30
VK_TOPIC_DISCOVERY_FIRST_DELAY_SECONDS=20
VK_CHROMIUM_BIN=chromium
VK_BROWSER_WAIT_MS=12000

THE_ODDS_API_KEY=
THE_ODDS_API_SPORT=soccer_epl
THE_ODDS_API_REGIONS=eu
THE_ODDS_API_MARKETS=h2h,totals
THE_ODDS_API_BOOKMAKER=market_avg
THE_ODDS_API_DAYS_AHEAD=30

API_FOOTBALL_KEY=
FOOTBALL_DATA_TOKEN=
THESPORTSDB_KEY=123

LOG_LEVEL=INFO
